\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Radial-grid convergence of the core-Hamiltonian lowest-MO energy of a single hydrogen atom, for three radial quadrature schemes: Becke, Treutler-Ahlrichs (M3) ($\alpha =0$) and (M4) ($\alpha =0.6$), all with element scaling $\xi (\mathrm  {H})=0.8$. Basis: QZ4P (ADF Slater-type). Angular grid: Lebedev, fixed at order $L=29$. The radial point count is swept over $n_\mathrm  {rad}\in \{10,20,40,80,160,320,640\}$. The reference is the mean of the three schemes on the finest grid ($n_\mathrm  {rad}=1280$), $E_\mathrm  {ref}\approx -0.5$ (a shared self-reference; the exact $1s$ energy is $-0.5$~Ha). The ordinate is $|E-E_\mathrm  {ref}|$.\relax }}{19}{figure.caption.9}\protected@file@percent }
\newlabel{fig:conv_radial_h}{{5}{19}{Radial-grid convergence of the core-Hamiltonian lowest-MO energy of a single hydrogen atom, for three radial quadrature schemes: Becke, Treutler-Ahlrichs (M3) ($\alpha =0$) and (M4) ($\alpha =0.6$), all with element scaling $\xi (\mathrm {H})=0.8$. Basis: QZ4P (ADF Slater-type). Angular grid: Lebedev, fixed at order $L=29$. The radial point count is swept over $n_\mathrm {rad}\in \{10,20,40,80,160,320,640\}$. The reference is the mean of the three schemes on the finest grid ($n_\mathrm {rad}=1280$), $E_\mathrm {ref}\approx -0.5$ (a shared self-reference; the exact $1s$ energy is $-0.5$~Ha). The ordinate is $|E-E_\mathrm {ref}|$.\relax }{figure.caption.9}{}}
