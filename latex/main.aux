\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Control-flow of the neighbor-tiled RI-J kernel (\texttt  {compute\_coulomb\_tiled}). One Kokkos team is launched per neighbor-list box. Kernel~1 accumulates the fitted-density coefficients $y_\alpha $; a host-side application of $(\alpha |\beta )^{-1}$ (two GEMVs) rescales them to $z_\alpha $; Kernel~2 assembles $\tilde  J_{\mu \nu }$. The inner dashed boxes are the lower-triangular neighbor-tile loops, in which $\phi _a,\phi _b$ are evaluated once into team scratch and reused. Colors follow Figure \ref {fig:becke_team_flow}: yellow for data-parallel global work, orange for team-thread work in scratch, green for atomic accumulation into global memory, and blue for host / BLAS calls.\relax }}{17}{figure.caption.5}\protected@file@percent }
\newlabel{fig:tiled_rij_flow}{{3}{17}{Control-flow of the neighbor-tiled RI-J kernel (\texttt {compute\_coulomb\_tiled}). One Kokkos team is launched per neighbor-list box. Kernel~1 accumulates the fitted-density coefficients $y_\alpha $; a host-side application of $(\alpha |\beta )^{-1}$ (two GEMVs) rescales them to $z_\alpha $; Kernel~2 assembles $\tilde J_{\mu \nu }$. The inner dashed boxes are the lower-triangular neighbor-tile loops, in which $\phi _a,\phi _b$ are evaluated once into team scratch and reused. Colors follow Figure \ref {fig:becke_team_flow}: yellow for data-parallel global work, orange for team-thread work in scratch, green for atomic accumulation into global memory, and blue for host / BLAS calls.\relax }{figure.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Memory allocations in \texttt  {compute\_coulomb\_tiled}. Both kernels share the per-team scratch layout ($\rho _g$ for Kernel~1, $v_g$ for Kernel~2). All device views use \texttt  {LayoutLeft}; $P_\text  {max}=\texttt  {max\_points\_per\_box}$ and $\texttt  {tile}=\texttt  {tile\_size}$ (default 32). The scratch footprint $(3+2\,\texttt  {tile})\,P_\text  {max}$ doubles plus $P_\text  {max}$ points is independent of the neighbor count.\relax }}{17}{table.caption.6}\protected@file@percent }
\newlabel{tab:tiled_rij_memory}{{3}{17}{Memory allocations in \texttt {compute\_coulomb\_tiled}. Both kernels share the per-team scratch layout ($\rho _g$ for Kernel~1, $v_g$ for Kernel~2). All device views use \texttt {LayoutLeft}; $P_\text {max}=\texttt {max\_points\_per\_box}$ and $\texttt {tile}=\texttt {tile\_size}$ (default 32). The scratch footprint $(3+2\,\texttt {tile})\,P_\text {max}$ doubles plus $P_\text {max}$ points is independent of the neighbor count.\relax }{table.caption.6}{}}
\citation{Karton11w411}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Control-flow of the neighbor-tiled RI-K kernel (\texttt  {compute\_exact\_exchange\_tiled}). The occupied orbitals are treated one at a time: orbital $i$ is folded into the quadrature weights via $c^i(\mathbf  r_g)=\DOTSB \sum@ \slimits@ _k C_{ki}\phi _k(\mathbf  r_g)$, the three-center integral $(\nu i|\alpha )$ is built by the tiled team kernel (each neighbor tile of $\phi _j$ evaluated once and reused across all auxiliary functions $\alpha $), and $\tilde  K_{\mu \nu }$ is accumulated by two host GEMMs applying $X^{-\frac  12}$. Colors as in Figure \ref {fig:tiled_rij_flow}.\relax }}{18}{figure.caption.7}\protected@file@percent }
\newlabel{fig:tiled_rik_flow}{{4}{18}{Control-flow of the neighbor-tiled RI-K kernel (\texttt {compute\_exact\_exchange\_tiled}). The occupied orbitals are treated one at a time: orbital $i$ is folded into the quadrature weights via $c^i(\mathbf r_g)=\sum _k C_{ki}\phi _k(\mathbf r_g)$, the three-center integral $(\nu i|\alpha )$ is built by the tiled team kernel (each neighbor tile of $\phi _j$ evaluated once and reused across all auxiliary functions $\alpha $), and $\tilde K_{\mu \nu }$ is accumulated by two host GEMMs applying $X^{-\frac 12}$. Colors as in Figure \ref {fig:tiled_rij_flow}.\relax }{figure.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Memory allocations in \texttt  {compute\_exact\_exchange\_tiled}. All device views use \texttt  {LayoutLeft}; $P_\text  {max}=\texttt  {max\_points\_per\_box}$ and $\texttt  {tile}=\texttt  {tile\_size}$ (default 32). The three global device matrices are reused across the loop over occupied orbitals; the per-team scratch footprint $(2+\texttt  {tile})\,P_\text  {max}$ doubles plus $P_\text  {max}$ points is independent of the neighbor count.\relax }}{18}{table.caption.8}\protected@file@percent }
\newlabel{tab:tiled_rik_memory}{{4}{18}{Memory allocations in \texttt {compute\_exact\_exchange\_tiled}. All device views use \texttt {LayoutLeft}; $P_\text {max}=\texttt {max\_points\_per\_box}$ and $\texttt {tile}=\texttt {tile\_size}$ (default 32). The three global device matrices are reused across the loop over occupied orbitals; the per-team scratch footprint $(2+\texttt {tile})\,P_\text {max}$ doubles plus $P_\text {max}$ points is independent of the neighbor count.\relax }{table.caption.8}{}}
