@PACKAGE_INIT@

# 1. Include the macro to handle dependencies
include(CMakeFindDependencyMacro)

# 2. Re-find your library's required dependencies
# find_dependency is like find_package, but it propagates "REQUIRED" and "QUIET" 
# status from the parent call to find_package(NuKEXC).
find_dependency(Kokkos REQUIRED)
find_dependency(IntegratorXX REQUIRED)

# 3. Include the auto-generated targets file
# This is the file generated by your install(EXPORT ...) command.
include("${CMAKE_CURRENT_LIST_DIR}/NuKEXCTargets.cmake")

check_required_components(NuKEXC)
